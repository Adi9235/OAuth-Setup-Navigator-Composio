# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/oauth_navigator

# LLM / search keys are OPTIONAL server defaults: visitors can enter their own keys, provider and
# model on the in-app "API keys" page. Default provider: groq (free tier: https://console.groq.com);
# anthropic = Claude (larger budgets, faster).
LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Defaults: openai/gpt-oss-120b (groq), claude-sonnet-5-5 (anthropic).
LLM_MODEL=

# Web search
TAVILY_API_KEY=

# Runtime
JOB_CONCURRENCY=2
APP_BASE_URL=http://localhost:3000
USER_AGENT=OAuthSetupNavigator/0.1 (+https://github.com/Adi9235/OAuth-Setup-Navigator-Composio)
