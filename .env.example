# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/oauth_navigator

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Web search
TAVILY_API_KEY=

# Runtime
JOB_CONCURRENCY=2
APP_BASE_URL=http://localhost:3000
USER_AGENT=OAuthSetupNavigator/0.1 (+https://github.com/<you>/oauth-setup-navigator)
